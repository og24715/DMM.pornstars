{
  "name": "DMM.pornstars",
  "version": "1.4.0",
  "description": "DMM.com でお気に入りのAV女優をフォローし、その一覧を表示できるようにする拡張機能です。",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": [
        "*://www.dmm.co.jp/digital/videoa/-/detail/*"
      ],
      "js": [
        "detail.bundle.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.bundle.js"
  },
  "action": {},
  "permissions": [
    "storage",
    "tabs"
  ]
}
